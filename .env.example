# Copy to .env and fill real values. Do not commit .env.

# Keep runtime artifacts on the external disk when possible.
PERSONAL_NEWS_EXT_ROOT=/Volumes/ext
PERSONAL_NEWS_DB=sqlite:////Volumes/ext/personal_news_agent/personal_news.db
PERSONAL_NEWS_SEED_DEMO=0

# Crawl URL queue/state backend. MySQL owns crawl URLs and refresh state;
# SQLite remains only a local development fallback for app metadata/articles.
PERSONAL_NEWS_CRAWL_URL_BACKEND=mysql
PERSONAL_NEWS_CRAWL_DB_URL=mysql+pymysql://user:password@host:3306/personal_news?charset=utf8mb4
PERSONAL_NEWS_CRAWL_INTERVAL_MINUTES=10
PERSONAL_NEWS_CRAWL_INTERVAL_MAX_MINUTES=20
# Local single-process startup may keep this at 1. The systemd Web unit
# overrides it so the standalone crawler remains the only production crawler.
PERSONAL_NEWS_BACKGROUND_CRAWL=1

# Elasticsearch owns article recall/search. If empty, the app falls back to
# SQLite FTS for local development.
PERSONAL_NEWS_SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://127.0.0.1:9200
PERSONAL_NEWS_ES_INDEX=personal_news_articles
PNA_HTTP_VERIFY_SSL=1

# Optional: stock_agent database connection for creating pna_* user tables.
# The current MVP runtime uses SQLite by default; use sql/pna_schema_mysql.sql
# against this database when deploying the user/profile tables into stock_agent.
PNA_USER_DB_URL=mysql+pymysql://user:password@host:3306/stock_agent?charset=utf8mb4

# DeepSeek is the single provider for the OpenAI-compatible LLM client and the
# Anthropic-compatible CC Runtime. Configure exactly one API key.
PNA_LLM_ENDPOINT=https://api.deepseek.com
PNA_LLM_KEY=
# One real provider model shared by ordinary LLM, CC Runtime, and compatibility agent.
PNA_LLM_MODEL=deepseek-v4-flash
# UI default logical role; this does not select a provider model.
PNA_LLM_DEFAULT_MODEL=yuanrong-personal-assistant
PNA_LLM_TIMEOUT_SECONDS=120

# Optional Claude Agent SDK runtime controller. It receives only the two
# read-only application tools: local news search and the configured external
# web search. When disabled/unavailable, chat falls back to the existing
# deterministic research pipeline.
PNA_CC_RUNTIME_ENABLED=1
# DeepSeek CC automatically derives https://api.deepseek.com/anthropic and
# reuses PNA_LLM_KEY. Do not configure a second CC URL or key.
PNA_CC_RUNTIME_EFFORT=max
PNA_CC_RUNTIME_MAX_TURNS=6
PNA_CC_RUNTIME_MAX_BUDGET_USD=
PNA_CC_RUNTIME_TIMEOUT_SECONDS=150
PNA_CC_RUNTIME_ALLOW_EXISTING_LOGIN=0
PNA_CC_RUNTIME_BUILTIN_WEB_SEARCH=1
PNA_CC_RUNTIME_CONFIG_DIR=data/cc_runtime

# Compatibility-agent conversation state only; its endpoint, key, model and
# timeout all come from the PNA_LLM_* contract above.
PNA_LOCAL_AGENT_MAX_HISTORY=30
PNA_LOCAL_AGENT_TEMPERATURE=0.2
PNA_LOCAL_AGENT_SESSION_STORE=data/local_agent_sessions.json

# Phone account registration. SMS possession verification is mandatory.
# Production: aliyun_pnvs. Local tests may explicitly use mock.
PNA_PHONE_CHALLENGE_PROVIDER=disabled
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
PNA_PHONE_CHALLENGE_SECRET=
PNA_PHONE_CHALLENGE_MOCK_ENABLED=0
PNA_PHONE_CHALLENGE_MOCK_CODE=123456
PNA_PHONE_CHALLENGE_TTL_SECONDS=600
PNA_PHONE_CHALLENGE_RESEND_SECONDS=60
PNA_PHONE_CHALLENGE_MAX_ATTEMPTS=5
PNA_PHONE_CHALLENGE_RATE_WINDOW_SECONDS=3600
PNA_PHONE_CHALLENGE_MOBILE_RATE_LIMIT=5
PNA_PHONE_CHALLENGE_IP_RATE_LIMIT=20
PNA_PNVS_SIGN_NAME=
PNA_PNVS_TEMPLATE_CODE=100001
PNA_PNVS_SCHEME_NAME=pna-register
PNA_PNVS_ENDPOINT=dypnsapi.aliyuncs.com

# WeChat official OAuth settings.
# WeChat is not part of the current registration flow; keep these empty unless
# you later re-enable WeChat login.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=http://127.0.0.1:8000/api/auth/wechat/callback
WECHAT_LOGIN_MODE=website

# Optional external search.
EXTERNAL_SEARCH_PROVIDER=none
BING_SEARCH_KEY=
TAVILY_API_KEY=
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search
TAVILY_SEARCH_DEPTH=basic
TAVILY_TRUST_ENV=0

# Optional read-only everyday tools for normal CC chat. Providers are kept
# separate from news search and business Skills. Weather works without a key;
# one optional AMap Web Service key enables China route planning too.
PNA_EVERYDAY_API_TIMEOUT_SECONDS=10
# Weather works without registration or a key for non-commercial use.
PNA_OPEN_METEO_WEATHER_ENDPOINT=https://api.open-meteo.com/v1/forecast
PNA_OPEN_METEO_GEOCODING_ENDPOINT=https://geocoding-api.open-meteo.com/v1/search
# Optional: enables China route planning and replaces Open-Meteo weather.
PNA_AMAP_WEB_KEY=
PNA_AMAP_WEB_ENDPOINT=https://restapi.amap.com
# Juhe train and flight products may issue separate keys. Configure either one
# independently; these tools only query schedules/status and never book or pay.
PNA_JUHE_TRAIN_KEY=
PNA_JUHE_FLIGHT_KEY=
PNA_JUHE_TRAIN_ENDPOINT=https://apis.juhe.cn/fapigw/train/query
PNA_JUHE_FLIGHT_ENDPOINT=https://v.juhe.cn/flight_dynamic/query

# Optional real-name/mobile match. It does not prove phone possession and is
# not used as a replacement for the SMS registration code.
PNA_REALNAME_PROVIDER=mock
PNA_REALNAME_MOCK_ENABLED=1

# Alibaba Cloud credentials used by PNVS and real-name verification.
# These names intentionally match the existing local .env contract. There is
# no alias fallback: missing values make the provider unavailable at startup.
AccessKeyID=
AccessKeySecret=
ALIYUN_CLOUDAUTH_ENDPOINT=cloudauth.aliyuncs.com
ALIYUN_REGION_ID=cn-beijing
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
ALIYUN_CONTENT_MODERATION_QUERY_SERVICE="llm_query_moderation"
ALIYUN_CONTENT_MODERATION_ENDPOINT="green-cip.cn-shanghai.aliyuncs.com"
